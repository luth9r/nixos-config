[General]
Font="@font@"
FontSize="@fontSize@"
RoundCorners="@rounding@"
HourFormat="HH:mm"
DateFormat="dd.MM.yyyy"
PartialBlur="true"
Blur="1.5"
BlurMax="32"
FormPosition="center"
PasswordFocus="true"
DimBackground="0.15"
Background="Backgrounds/wallpaper.jpg"
BackgroundPlaceholder="Backgrounds/wallpaper.jpg"

HeaderTextColor="@colorFg@"
DateTextColor="@colorFg@"
TimeTextColor="@colorFg@"
FormBackgroundColor="@colorBgAlt@"
BackgroundColor="@colorBg@"
DimBackgroundColor="@colorBg@"
LoginFieldBackgroundColor="@colorSurface@"
PasswordFieldBackgroundColor="@colorSurface@"
LoginFieldTextColor="@colorFg@"
PasswordFieldTextColor="@colorFg@"
UserIconColor="@colorFg@"
PasswordIconColor="@colorFg@"
PlaceholderTextColor="@colorFgMuted@"
WarningColor="@colorWarning@"
LoginButtonTextColor="@colorAccentFg@"
LoginButtonBackgroundColor="@colorAccent@"
SystemButtonsIconsColor="@colorFg@"
SessionButtonTextColor="@colorFg@"
VirtualKeyboardButtonTextColor="@colorFg@"
DropdownTextColor="@colorFg@"
DropdownSelectedBackgroundColor="@colorBorder@"
DropdownBackgroundColor="@colorBgAlt@"
HighlightTextColor="@colorFg@"
HighlightBackgroundColor="@colorBorder@"
HighlightBorderColor="@colorBorder@"
HoverUserIconColor="@colorFg@"
HoverPasswordIconColor="@colorFg@"
HoverSystemButtonsIconsColor="@colorFg@"
HoverSessionButtonTextColor="@colorFg@"
HoverVirtualKeyboardButtonTextColor="@colorFg@"

[Users]
RememberLastUser=true
