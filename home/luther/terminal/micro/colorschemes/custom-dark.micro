color-link default "#f8f8f2,#000000"
color-link comment "#75715e"
color-link constant "#ae81ff"
color-link constant.string "#e6db74"
color-link constant.string.char "#e6db74"
color-link constant.number "#ae81ff"
color-link identifier "#a6e22e"
color-link identifier.class "bold underline #66d9ef"
color-link identifier.var "#fd971f"
color-link statement "bold #f92672"
color-link symbol "#f8f8f2"
color-link symbol.operator "#f92672"
color-link preproc "bold #f92672"
color-link type "#66d9ef"
color-link special "#66d9ef"
color-link underlined "underline #66d9ef"
color-link error "bold #f92672,#1e0010"
color-link todo "bold #e6db74,#000000"
color-link statusline "#f8f8f2,#1e1e1e"
color-link tabbar "#f8f8f2,#1e1e1e"
color-link indent-char "#3e3d32"
color-link line-number "#666666,#000000"
color-link current-line-number "bold #f8f8f2,#1a1a1a"
color-link cursor-line "#1a1a1a"
color-link color-column "#1a1a1a"
color-link type.extended "default"
color-link divider "#282828"
