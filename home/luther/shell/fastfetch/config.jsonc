{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "general": {
    "thread": true
  },
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 0,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰄾 "
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": "󱄅 os"
    },
    {
      "type": "kernel",
      "key": "󰌽 ker"
    },
    {
      "type": "uptime",
      "key": "󱑂 up"
    },
    {
      "type": "shell",
      "key": "󰞷 sh"
    },
    {
      "type": "wm",
      "key": "󱂬 wm"
    },
    {
      "type": "terminal",
      "key": "󰞷 term"
    },
    {
      "type": "cpu",
      "key": "󰍛 cpu"
    },
    {
      "type": "gpu",
      "key": "󰍛 gpu"
    },
    {
      "type": "memory",
      "key": "󰘚 mem"
    },
    "break",
    "colors"
  ]
}
