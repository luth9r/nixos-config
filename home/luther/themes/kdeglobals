# Centralized KDE / Dolphin Color Scheme and Font Configuration
# Generated dynamically from vars.nix

[General]
ColorScheme=Monochrome
font=@font@,10,-1,5,50,0,0,0,0,0
menuFont=@font@,10,-1,5,50,0,0,0,0,0
